{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        
        "baseUrl": ".",
        "outDir": "dist",
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*",
        "**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}